DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this
SESSION_SECRET=generate-a-long-random-secret
NODE_ENV=production
